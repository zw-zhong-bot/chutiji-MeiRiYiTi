#!/bin/sh
# ---------------------------------------------------------------------------
# chutiji Maven Wrapper (POSIX)
# 与 mvnw.cmd 等价：进程内锁定 JDK 21，本地仓库放工程内 .m2repo。
# ---------------------------------------------------------------------------
set -e

MVNW_DIR=$(cd "$(dirname "$0")" && pwd)

CHUTIJI_JDK="${CHUTIJI_JDK:-C:/Program Files/Java/jdk-21}"
if [ ! -x "$CHUTIJI_JDK/bin/java" ] && [ ! -x "$CHUTIJI_JDK/bin/java.exe" ]; then
  echo "[mvnw] JDK 21 not found at $CHUTIJI_JDK. Set CHUTIJI_JDK to override." >&2
  exit 1
fi
export JAVA_HOME="$CHUTIJI_JDK"
export MAVEN_USER_HOME="$MVNW_DIR/.mvn/maven-home"

MAVEN_HOME="$MVNW_DIR/.mvn/maven-home/wrapper/dists/apache-maven-3.9.11/03d7e36a140982eea48e22c1dcac01d8862b2550b2939e09a0809bbc5182a5bc"
if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  echo "[mvnw] Maven distribution missing at $MAVEN_HOME." >&2
  exit 1
fi

exec "$MAVEN_HOME/bin/mvn" -Dmaven.repo.local="$MVNW_DIR/.m2repo" -s "$MVNW_DIR/.mvn/settings.xml" "$@"
